#!/bin/bash
#SBATCH -J si-box
#SBATCH -o job.%j.out
#SBATCH -e job.%j.err
#SBATCH -p cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=36       
#SBATCH --mem=58G
#SBATCH -t 24:00:00

N=${1:?usage: sbatch -w <node> job.mpi <ncells>}
export OMP_NUM_THREADS=20         # physical cores
export MKL_NUM_THREADS=20
export OPENBLAS_NUM_THREADS=20

source /u0/anirban/miniconda3/etc/profile.d/conda.sh
conda activate base
echo "Job $SLURM_JOB_ID on $(hostname): ncells=$N, $OMP_NUM_THREADS threads"

python3 -u silicon_pure_box.py --ncells $N --no-sparse   # exact edges, seconds
python3 -u silicon_pure_box.py --ncells $N               # sparse check
